# Seyvix edge: static SPA + reverse proxy to the API + automatic HTTPS.
#
# SITE_ADDRESS  ":80" (plain HTTP, default) or a domain, e.g. "seyvix.example.com";
#               with a domain Caddy obtains and renews a Let's Encrypt certificate itself.
# MAX_BODY_SIZE request body limit for /api/* (keep slightly above MAX_UPLOAD_BYTES).
{
	admin off
	log {
		format json
	}
	servers {
		timeouts {
			read_header 15s
			idle 2m
		}
	}
}

# Container healthcheck endpoint (not published).
http://127.0.0.1:2080 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"
	header {
		-Server
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		# Telegram Web App runs the SPA inside an iframe on web.telegram.org.
		?Content-Security-Policy "frame-ancestors 'self' https://telegram.org https://*.telegram.org"
	}

	handle /api/* {
		request_body {
			max_size {$MAX_BODY_SIZE:110MB}
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 10m
			}
		}
	}

	root * /srv

	# Content-hashed bundles: cache forever, never fall back to index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
