# Seyvix — конфигурация. Скопируйте в .env: `scripts/init-env.sh` (сам сгенерирует секреты)
# или `cp .env.example .env` и заполните секреты вручную: `openssl rand -hex 32`.
# Одна и та же переменная читается api, воркерами и docker compose; .env никогда не коммитится.
# Полный список настроек с дефолтами: backend/app/core/config.py (имя поля = имя переменной).

# ======================== Docker Compose / сервер ========================
# Домен сайта. С доменом Caddy сам получит и будет продлевать HTTPS-сертификат
# (нужны A/AAAA-записи на сервер и открытые 80/443). ":80" — только HTTP (локально).
SITE_ADDRESS=:80
# Внешние порты Caddy (менять только если 80/443 заняты, например локально).
#HTTP_PORT=80
#HTTPS_PORT=443
# Лимит тела запроса к /api/* на прокси; держите чуть больше MAX_UPLOAD_BYTES.
#MAX_BODY_SIZE=110MB
# Профили compose: "telegram" включает сервис telegram-bot.
#COMPOSE_PROFILES=telegram
# Образы: локально собираются как seyvix/<name>:local. На сервере scripts/deploy.sh
# сам выставляет IMAGE_PREFIX (ghcr.io/<owner>/<repo>) и IMAGE_TAG (sha коммита).
#IMAGE_PREFIX=ghcr.io/owner/seyvix
#IMAGE_TAG=local

# ======================== Приложение ========================
# production включает проверку секретов при старте (слабые/дефолтные значения => отказ
# стартовать), отключает /api/v1/docs и dev-логин. Для разработки dev-оверлей сам ставит
# development, менять здесь не нужно.
APP_ENV=production
# Публичный адрес (схема + домен, без завершающего /). От него зависят secure-cookie
# (только при https://), редирект Telegram Login и кнопка Telegram Web App.
PUBLIC_URL=http://localhost
LOG_LEVEL=INFO
# Максимальный размер загружаемого файла, байт (100 МиБ).
MAX_UPLOAD_BYTES=104857600
# Нужен только если фронтенд открыт с другого origin (через Caddy всё same-origin).
# Формат: через запятую или JSON-список.
CORS_ALLOWED_ORIGINS=

# ======================== PostgreSQL ========================
POSTGRES_DB=seyvix
POSTGRES_USER=seyvix
# Обязательно: openssl rand -hex 32
POSTGRES_PASSWORD=

# ======================== Хранилище файлов ========================
# local — именованный том `storage` (дефолт, попадает в scripts/backup.sh).
# s3 — любой S3-совместимый сервис (тогда бэкап бакета — ваша забота).
STORAGE_BACKEND=local
#S3_ENDPOINT_URL=https://s3.example.com
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_BUCKET=seyvix
#S3_REGION=us-east-1

# ======================== Аутентификация ========================
# Обязательно: openssl rand -hex 32
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Абсолютный срок жизни сессии (refresh не продлевает её дальше), дней.
#REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=180

# ======================== Доступ (allowlist) ========================
# allowlist — входить могут только админы и пользователи, которым выдан доступ
# (в веб-интерфейсе «Настройки → Доступ» или командами бота /allow, /deny, /access).
# open — любой пользователь Telegram.
ACCESS_MODE=allowlist
# Telegram user id администраторов через запятую (узнать свой id: @userinfobot).
# В режиме allowlist в production обязателен хотя бы один.
ADMIN_TELEGRAM_IDS=

# ======================== Telegram ========================
# Токен бота от @BotFather. Нужен и api (проверка входа), и telegram-bot.
TELEGRAM_BOT_TOKEN=
# Общий секрет api <-> telegram-bot. Обязателен, если задан TELEGRAM_BOT_TOKEN
# в production: openssl rand -hex 32
TELEGRAM_INTERNAL_TOKEN=
# Вход на сайте через Telegram (OpenID Connect): BotFather → Bot Settings → Web Login.
# Redirect URL там: <PUBLIC_URL>/auth/callback
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Необязательно: прокси для обращений к oauth.telegram.org (если сервер не видит Telegram).
#TELEGRAM_OIDC_PROXY_URL=
# Необязательно: свой Bot API сервер (по умолчанию https://api.telegram.org).
#TELEGRAM_API_BASE=
# Сообщения бота, пришедшие в пределах окна (сек), склеиваются в одну заметку.
#TELEGRAM_GROUP_WINDOW_SECONDS=3

# ======================== AI ========================
# Без AI_API_KEY приложение работает полностью: поиск только полнотекстовый,
# AI-обработка пропускается. AI_API_KEY включает AI-функции; если embeddings используют
# отдельный API, задайте для него AI_EMBEDDING_API_KEY. Иначе используется AI_API_KEY.
AI_BASE_URL=https://api.experientiallabs.ai/v1
AI_API_KEY=
# Суффикс :free отключает переход на платную модель после исчерпания бесплатного лимита.
AI_CHAT_MODEL=deepseek-v4.1-flash:free
AI_VISION_MODEL=deepseek-v4.1-flash:free
AI_TRANSCRIPTION_MODEL=whisper-1
# Для эмбеддингов задан отдельный API-адрес; укажите и отдельный ключ ниже.
AI_EMBEDDING_BASE_URL=https://api.jina.ai/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# Эта модель принимает task отдельно для документов и поисковых запросов.
AI_EMBEDDING_TASK=retrieval.passage
AI_EMBEDDING_QUERY_TASK=retrieval.query
# Необязательно: отдельная embedding-модель для поисковых запросов.
# Если не задана, используется AI_EMBEDDING_MODEL.
AI_EMBEDDING_QUERY_MODEL=
# Размерность половинного вектора зашита в схему БД; при её изменении нужна миграция
# и повторная векторизация. Если провайдер не принимает параметр dimensions, выключите его
# и укажите ниже родную размерность модели.
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_SEND_DIMENSIONS=true
#AI_EMBEDDING_BATCH_SIZE=32
# Одновременных запросов к AI на процесс.
AI_MAX_CONCURRENCY=4
# Отдельные AI-функции (работают только при заданном AI_API_KEY).
AI_TAGS_ENABLED=true
AI_TAXONOMY_ENABLED=true
AI_OCR_ENABLED=true
AI_VISION_ENABLED=false
AI_TRANSCRIPTION_ENABLED=false
AI_QUERY_EXPANSION_ENABLED=false
# Необязательно: отдельный провайдер для других возможностей (иначе AI_BASE_URL/AI_API_KEY).
#AI_VISION_BASE_URL=
#AI_VISION_API_KEY=
#AI_TRANSCRIPTION_BASE_URL=
#AI_TRANSCRIPTION_API_KEY=
#
# Конфигурация полнотекстового поиска Postgres (simple — без морфологии, подходит для
# смеси языков). Зашита в схему БД — выберите до первого запуска.
#SEARCH_FTS_CONFIG=simple

# ======================== Снимки (snapshot-worker) ========================
SNAPSHOT_SCREENSHOT_ENABLED=true
SNAPSHOT_PAGE_PDF_ENABLED=true
SNAPSHOT_WEBPAGE_HTML_ENABLED=false
SNAPSHOT_OFFICE_CONVERSION_ENABLED=true
# Параллельных снимков (каждый — Chromium/LibreOffice; на 4 ГБ оставьте 1).
WORKER_SNAPSHOT_CONCURRENCY=1

# ======================== Обслуживание ========================
# Через сколько дней заметки из корзины удаляются окончательно.
TRASH_RETENTION_DAYS=30
