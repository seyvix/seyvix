APP_NAME=VKR API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
API_PORT=8000

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_REDIRECT_URL=http://localhost:3000/auth/telegram
TELEGRAM_LOGIN_MAX_AGE_SECONDS=86400
TELEGRAM_LOGIN_CODE_TTL_SECONDS=60

TELEGRAM_DEV_LOGIN_ENABLED=false
TELEGRAM_DEV_USER_ID=777001
TELEGRAM_DEV_FIRST_NAME=Local
TELEGRAM_DEV_LAST_NAME=Tester
TELEGRAM_DEV_USERNAME=local_tester
TELEGRAM_DEV_PHOTO_URL=

POSTGRES_HOST=localhost
POSTGRES_DB=vkr_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=app.events
RABBITMQ_SNAPSHOT_QUEUE=snapshot-worker.events
RABBITMQ_SNAPSHOT_RETRY_QUEUE=snapshot-worker.events.retry
RABBITMQ_SNAPSHOT_DLQ=snapshot-worker.events.dlq
RABBITMQ_RETRY_TTL_MS=30000
OUTBOX_PUBLISHER_BATCH_SIZE=50
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=2

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-password
S3_BUCKET=app-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

AUTH_JWT_SECRET=change-me-for-production-32-bytes
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

CONTENT_STORAGE_ROOT=data/content
SNAPSHOT_ARCHIVE_SCREENSHOT_ENABLED=true
SNAPSHOT_ARCHIVE_WEBPAGE_HTML_ENABLED=true
SNAPSHOT_ARCHIVE_PDF_ENABLED=true
SNAPSHOT_ARCHIVE_MARKDOWN_ENABLED=true
SNAPSHOT_ARCHIVE_ORG_ENABLED=false
SNAPSHOT_WORKER_BATCH_SIZE=10
SNAPSHOT_WORKER_POLL_INTERVAL_SECONDS=10
SNAPSHOT_OFFICE_CONVERTER_COMMAND=

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:5173"]
CORS_ALLOW_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*temaa\.space
