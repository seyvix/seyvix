# Compose entrypoint
APP_PORT=8080
APP_SERVER_NAME=_
WEB_SERVER_NAME=web.localhost
API_SERVER_NAME=api.localhost
CLIENT_MAX_BODY_SIZE=100m

# Optional direct dev ports. docker-compose.dev.yml exposes them.
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_NAME=VKR API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_TOKEN=change-me-for-production-32-bytes
TELEGRAM_BACKEND_BASE_URL=http://backend:8000/api/v1
TELEGRAM_WEB_APP_URL=http://localhost:8080
TELEGRAM_DEFAULT_GROUP_WINDOW_SECONDS=3
TELEGRAM_BOT_POLL_TIMEOUT_SECONDS=30
TELEGRAM_LOGIN_REDIRECT_URL=http://localhost:8080/auth/telegram
TELEGRAM_LOGIN_MAX_AGE_SECONDS=86400
TELEGRAM_LOGIN_CODE_TTL_SECONDS=60

TELEGRAM_DEV_LOGIN_ENABLED=false
TELEGRAM_DEV_USER_ID=777001
TELEGRAM_DEV_FIRST_NAME=Local
TELEGRAM_DEV_LAST_NAME=Tester
TELEGRAM_DEV_USERNAME=local_tester
TELEGRAM_DEV_PHOTO_URL=

POSTGRES_HOST=postgres
POSTGRES_DB=vkr_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=redis
REDIS_DB=0
REDIS_PASSWORD=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=app.events
RABBITMQ_SNAPSHOT_QUEUE=snapshot-worker.events
RABBITMQ_SNAPSHOT_RETRY_QUEUE=snapshot-worker.events.retry
RABBITMQ_SNAPSHOT_DLQ=snapshot-worker.events.dlq
RABBITMQ_VECTORIZATION_QUEUE=vectorization-worker.events
RABBITMQ_VECTORIZATION_RETRY_QUEUE=vectorization-worker.events.retry
RABBITMQ_VECTORIZATION_DLQ=vectorization-worker.events.dlq
RABBITMQ_TAXONOMY_QUEUE=taxonomy-worker.events
RABBITMQ_TAXONOMY_RETRY_QUEUE=taxonomy-worker.events.retry
RABBITMQ_TAXONOMY_DLQ=taxonomy-worker.events.dlq
RABBITMQ_TAGS_QUEUE=tags-worker.events
RABBITMQ_TAGS_RETRY_QUEUE=tags-worker.events.retry
RABBITMQ_TAGS_DLQ=tags-worker.events.dlq
RABBITMQ_RETRY_TTL_MS=30000
OUTBOX_PUBLISHER_BATCH_SIZE=50
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=2

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-password
S3_BUCKET=app-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

AUTH_JWT_SECRET=change-me-for-production-32-bytes
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

CONTENT_STORAGE_ROOT=data/content
SNAPSHOT_ARCHIVE_SCREENSHOT_ENABLED=true
SNAPSHOT_ARCHIVE_WEBPAGE_HTML_ENABLED=false
SNAPSHOT_ARCHIVE_PDF_ENABLED=true
SNAPSHOT_ARCHIVE_MARKDOWN_ENABLED=true
SNAPSHOT_ARCHIVE_ORG_ENABLED=false
SNAPSHOT_WORKER_BATCH_SIZE=10
SNAPSHOT_WORKER_POLL_INTERVAL_SECONDS=10
SNAPSHOT_OFFICE_CONVERTER_COMMAND=libreoffice

VECTOR_EMBEDDING_PROVIDER=ollama
VECTOR_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_MODEL=qwen3-embedding:0.6b
VECTOR_EMBEDDING_DIMENSIONS=1024
VECTOR_EMBEDDING_BATCH_SIZE=8
VECTOR_EMBEDDING_TIMEOUT_SECONDS=120
VECTOR_CHUNK_DEFAULT_MAX_TOKENS=384
VECTOR_CHUNK_DEFAULT_OVERLAP_TOKENS=48
VECTOR_CHUNK_MAX_DOCUMENT_CHARS=50000
VECTOR_CHUNK_MAX_CHUNKS_PER_DOCUMENT=120
VECTOR_CHUNK_CONFIG_VERSION=v1
VECTOR_WORKER_BATCH_SIZE=2
VECTOR_WORKER_POLL_INTERVAL_SECONDS=5
VECTOR_WORKER_LOCK_TIMEOUT_SECONDS=300

TAXONOMY_CLASSIFICATION_HIGH_THRESHOLD=0.80
TAXONOMY_CLASSIFICATION_MEDIUM_THRESHOLD=0.60
TAXONOMY_LLM_CLASSIFICATION_ACCEPT_THRESHOLD=0.80
TAXONOMY_LLM_CLASSIFICATION_PROPOSE_THRESHOLD=0.60
TAXONOMY_LLM_CLASSIFICATION_FALLBACK_TO_SEMANTIC=true
TAXONOMY_LLM_CLASSIFICATION_MODEL=qwen3:4b-thinking
TAXONOMY_LLM_PROVIDER=ollama
TAXONOMY_LLM_BASE_URL=http://host.docker.internal:11434/v1
TAXONOMY_LLM_API_KEY=
TAXONOMY_LLM_TIMEOUT_SECONDS=120
TAXONOMY_WORKER_BATCH_SIZE=10
TAXONOMY_WORKER_POLL_INTERVAL_SECONDS=10
TAXONOMY_WORKER_LOCK_TIMEOUT_SECONDS=300

TAGS_LLM_ENABLED=false
TAGS_LLM_MODEL=qwen3:4b-thinking
TAGS_LLM_PROVIDER=ollama
TAGS_LLM_BASE_URL=http://host.docker.internal:11434/v1
TAGS_LLM_API_KEY=
TAGS_LLM_TIMEOUT_SECONDS=120
TAGS_LLM_MAX_TAGS=8
TAGS_LLM_AUTO_APPLY_THRESHOLD=0.85
TAGS_LLM_SUGGEST_THRESHOLD=0.60
TAGS_LLM_CREATE_MISSING_TAGS=true
TAGS_LLM_PROMPT_VERSION=content_tags_v1
TAGS_WORKER_BATCH_SIZE=10
TAGS_WORKER_POLL_INTERVAL_SECONDS=10
TAGS_WORKER_LOCK_TIMEOUT_SECONDS=300

CORS_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_ORIGIN_REGEX=
