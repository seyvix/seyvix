# Build context is the repository root for every image. Allowlist only what the
# Dockerfiles copy so local data, secrets, caches and host build output never leak in.
*

!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/app
!backend/migrations

!telegram-bot/pyproject.toml
!telegram-bot/uv.lock
!telegram-bot/telegram_bot

!web
web/node_modules
web/build
web/dist
web/.react-router
web/**/*.test.ts
web/**/*.test.tsx

**/__pycache__
**/*.py[cod]
**/.DS_Store
